# devnet | testnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet

# Server-only RPC URL. Use a Helius, QuickNode, or similar URL in production.
# Do not prefix this with NEXT_PUBLIC.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Public URL used by the wallet connect button. This may be a public cluster URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional. Used for Open Graph metadata. Set this to the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Jupiter allows a low rate of keyless price requests.
# JUPITER_API_KEY=
